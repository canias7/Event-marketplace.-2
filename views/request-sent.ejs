<%- include('partials/head') %>

<h1>Request sent</h1>

<div class="ok">
  Your request has gone to <strong><%= sent.vendorName %></strong>.
  Your reference is <strong>#<%= sent.id %></strong>.
</div>

<h2>What happens now</h2>
<div class="card">
  <ol style="margin:0; padding-left:20px">
    <li>The vendor sees your request in their dashboard.</li>
    <li>They send you a price.</li>
    <li>You come back to the link below, check the price, and pay through this site.</li>
  </ol>
</div>

<h2>Your private link - keep it</h2>
<div class="card">
  <p style="margin-top:0" class="hint">
    This is how you get back to your booking. There is no password, so treat
    the link like one and do not share it.
  </p>
  <p style="margin-bottom:0">
    <a href="/booking/<%= sent.token %>">Open my booking</a>
  </p>
</div>

<p style="margin-top:24px"><a href="/">Browse more vendors</a></p>

<%- include('partials/foot') %>
