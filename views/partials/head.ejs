<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> - Event Vendora</title>
<style>
  /* Deliberately plain. Just enough to be readable and usable. */
  *{ box-sizing: border-box; }
  body { font: 16px/1.5 system-ui, sans-serif; margin: 0; color: #111; background: #fafafa; }
  header { background: #1a1a1a; color: #fff; padding: 12px 20px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  header a { color: #fff; text-decoration: none; }
  header .brand { font-weight: 700; margin-right: auto; }
  main { max-width: 900px; margin: 0 auto; padding: 24px 20px 60px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 28px 0 10px; }
  .sub { color: #666; margin: 0 0 24px; }
  label { display: block; margin: 14px 0 4px; font-weight: 600; font-size: 14px; }
  input, select, textarea { width: 100%; padding: 9px; border: 1px solid #bbb; border-radius: 4px; font: inherit; background: #fff; }
  textarea { min-height: 80px; }
  button { margin-top: 20px; padding: 10px 18px; border: 0; border-radius: 4px; background: #1a1a1a; color: #fff; font: inherit; cursor: pointer; }
  button:hover { background: #333; }
  .card { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 20px; }
  .narrow { max-width: 460px; }
  .error { background: #fde8e8; border: 1px solid #f0b4b4; color: #8a1f1f; padding: 10px 12px; border-radius: 4px; margin: 16px 0; }
  .ok { background: #e6f5ea; border: 1px solid #a8d9b8; color: #14532d; padding: 10px 12px; border-radius: 4px; margin: 16px 0; }
  .hint { color: #666; font-size: 13px; margin-top: 4px; }
  .mode { font-size: 13px; background: #fff7e0; border: 1px solid #e8d48a; padding: 8px 12px; border-radius: 4px; margin-bottom: 20px; }
  table { border-collapse: collapse; width: 100%; background: #fff; }
  th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid #e5e5e5; font-size: 14px; }
  th { background: #f2f2f2; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 560px) { .row2 { grid-template-columns: 1fr; } }
  a.btn { display: inline-block; margin-top: 16px; }
</style>
</head>
<body>
<header>
  <a class="brand" href="/">Event Vendora</a>
  <a href="/browse">Browse vendors</a>
  <% if (currentVendor) { %>
    <a href="/vendor">My dashboard</a>
    <form method="post" action="/vendor/logout" style="margin:0"><button style="margin:0;padding:6px 12px;font-size:14px">Log out</button></form>
  <% } else { %>
    <a href="/vendor/login">Vendor login</a>
  <% } %>
</header>
<main>
