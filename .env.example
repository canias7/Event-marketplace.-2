# ---------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# ".env" is ignored by git, so secrets never get pushed.
# ---------------------------------------------------------------

# Your Neon connection string. One string = address + user + password + db name.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Stripe TEST keys only. The app refuses to start if these are live keys.
# Leave both blank to run in pretend-payment mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Used to sign login cookies. Any long random string.
SESSION_SECRET=change-me-to-something-long-and-random

# What percent of each booking the marketplace keeps.
PLATFORM_FEE_PERCENT=10

PORT=3000
