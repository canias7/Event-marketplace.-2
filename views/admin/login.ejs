<%- include('../partials/head') %>

<h1>Admin login</h1>
<p class="sub">Marketplace owner only.</p>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<div class="card narrow">
<form method="post" action="/admin/login">
  <label>Email</label>
  <input type="email" name="email" value="<%= form.email || '' %>" required autofocus>
  <label>Password</label>
  <input type="password" name="password" required>
  <button type="submit">Log in</button>
</form>
</div>

<% if (noAdminYet) { %>
  <div class="mode" style="margin-top:24px">
    <strong>No admin account exists yet.</strong><br>
    Create one from the command line:<br>
    <code>npm run create-admin -- you@example.com yourpassword</code>
  </div>
<% } %>

<%- include('../partials/foot') %>
