<%- include('../partials/head') %>

<h1>Admin</h1>
<p class="sub">Everything on the marketplace.</p>

<div class="card">
  <table>
    <tr><th>Vendors</th><td><%= counts.vendors %></td></tr>
    <tr><th>Customers</th><td><%= counts.customers %></td></tr>
    <tr><th>Bookings</th><td><%= counts.bookings %></td></tr>
    <tr><th>Payments</th><td><%= counts.payments %></td></tr>
  </table>
</div>

<h2>Vendors</h2>
<table>
  <tr><th>Business</th><th>Category</th><th>City</th><th>Email</th><th>Joined</th></tr>
  <% for (const v of vendors) { %>
    <tr>
      <td><%= v.business_name %></td>
      <td><%= v.category_name %></td>
      <td><%= v.city || '-' %></td>
      <td><%= v.email %></td>
      <td><%= v.created_at.toISOString().slice(0,10) %></td>
    </tr>
  <% } %>
  <% if (!vendors.length) { %><tr><td colspan="5" style="color:#666">No vendors yet.</td></tr><% } %>
</table>

<form method="post" action="/admin/logout"><button>Log out</button></form>

<%- include('../partials/foot') %>
