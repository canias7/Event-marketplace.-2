# ---------------------------------------------------------------------------
# Neon Postgres connection strings
#
# This file is a TEMPLATE. It is committed to git on purpose and contains
# NO real passwords. Copy it to `.env.local` and paste your real values there.
#
#   cp .env.example .env.local
#
# `.env.local` is listed in .gitignore and must never be committed.
# ---------------------------------------------------------------------------

# POOLED connection — used by the app at runtime.
# In the Neon "Connect" modal, leave "Connection pooling" ON.
# The hostname will contain "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DIRECT (unpooled) connection — used for migrations and schema changes.
# Same modal, but toggle "Connection pooling" OFF.
# The hostname will NOT contain "-pooler".
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
