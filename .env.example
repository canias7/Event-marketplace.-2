# ---------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# ".env" is ignored by git, so secrets never get pushed.
# ---------------------------------------------------------------

# Your Neon connection string. One string = address + user + password + db name.
# Paste Neon's exactly as they give it to you, ?sslmode=require and all.
# Leave this blank to run on the built-in local database instead.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Stripe TEST keys only. The app refuses to start if these are live keys.
# Leave both blank to run in pretend-payment mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Used to sign login cookies. Any long random string.
#
# SET THIS BEFORE YOU GO LIVE. Without it the app invents a new one every
# time it starts, which logs every vendor out on each restart or deploy.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-something-long-and-random

# What percent of each booking the marketplace keeps.
PLATFORM_FEE_PERCENT=10

PORT=3000

# How many database connections to hold open. Neon limits this, and each
# copy of the app has its own set. 10 is plenty for one small app.
DB_POOL_MAX=10
